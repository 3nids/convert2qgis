{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DatasetGroup": {
      "additionalProperties": false,
      "properties": {
        "vector_datasets": {
          "items": {
            "$ref": "#/$defs/VectorDataset"
          },
          "type": "array"
        },
        "raster_datasets": {
          "items": {
            "$ref": "#/$defs/RasterDataset"
          },
          "type": "array"
        }
      },
      "required": [
        "vector_datasets",
        "raster_datasets"
      ],
      "title": "DatasetGroup",
      "type": "object"
    },
    "Field": {
      "additionalProperties": false,
      "dependentRequired": {
        "constraint_expression": [
          "constraint_expression_strength",
          "constraint_expression_description"
        ],
        "constraint_expression_description": [
          "constraint_expression",
          "constraint_expression_strength"
        ],
        "constraint_expression_strength": [
          "constraint_expression",
          "constraint_expression_description"
        ],
        "is_not_null": [
          "is_not_null_strength"
        ],
        "is_not_null_strength": [
          "is_not_null"
        ],
        "is_unique": [
          "is_unique_strength"
        ],
        "is_unique_strength": [
          "is_unique"
        ]
      },
      "properties": {
        "field_id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "real",
            "boolean",
            "datetime",
            "date",
            "time"
          ],
          "type": "string"
        },
        "length": {
          "minimum": 0,
          "type": "integer"
        },
        "precision": {
          "maximum": 15,
          "minimum": 0,
          "type": "integer"
        },
        "comment": {
          "type": "string"
        },
        "is_not_null": {
          "default": false,
          "type": "boolean"
        },
        "is_not_null_strength": {
          "default": "not_set",
          "enum": [
            "hard",
            "soft",
            "not_set"
          ],
          "type": "string"
        },
        "constraint_expression": {
          "default": "",
          "type": "string"
        },
        "constraint_expression_description": {
          "default": "",
          "type": "string"
        },
        "constraint_expression_strength": {
          "default": "not_set",
          "enum": [
            "hard",
            "soft",
            "not_set"
          ],
          "type": "string"
        },
        "is_unique": {
          "default": false,
          "type": "boolean"
        },
        "is_unique_strength": {
          "default": "not_set",
          "enum": [
            "hard",
            "soft",
            "not_set"
          ],
          "type": "string"
        },
        "default_value": {
          "default": "",
          "type": "string"
        },
        "set_default_value_on_update": {
          "type": "boolean"
        },
        "alias": {
          "type": "string"
        },
        "alias_expression": {
          "default": "",
          "type": "string"
        },
        "widget_type": {
          "enum": [
            "Hidden",
            "Color",
            "TextEdit",
            "Range",
            "DateTime",
            "ExternalResource",
            "CheckBox",
            "ValueMap",
            "ValueRelation"
          ],
          "type": "string"
        },
        "widget_config": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "alias",
        "comment",
        "length",
        "name",
        "precision",
        "set_default_value_on_update",
        "type",
        "widget_config",
        "widget_type"
      ],
      "title": "Field",
      "type": "object"
    },
    "FormItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/FormItemContainer"
        },
        {
          "$ref": "#/$defs/FormItemField"
        },
        {
          "$ref": "#/$defs/FormItemText"
        }
      ]
    },
    "FormItemContainer": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "tab",
            "group_box",
            "row"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/FormItem"
          },
          "type": "array"
        },
        "visibility_expression": {
          "default": "",
          "type": "string"
        },
        "background_color": {
          "default": "",
          "type": "string"
        },
        "is_collapsed": {
          "default": false,
          "type": "boolean"
        },
        "column_count": {
          "default": 1,
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "type",
        "label"
      ],
      "title": "FormItemContainer",
      "type": "object"
    },
    "FormItemField": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "field",
            "relation"
          ],
          "type": "string"
        },
        "field_name": {
          "minLength": 1,
          "type": "string"
        },
        "visibility_expression": {
          "default": "",
          "type": "string"
        },
        "show_label": {
          "default": true,
          "type": "boolean"
        },
        "is_read_only": {
          "default": false,
          "type": "boolean"
        },
        "is_label_on_top": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "type",
        "field_name"
      ],
      "title": "FormItemField",
      "type": "object"
    },
    "FormItemText": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "visibility_expression": {
          "default": "",
          "type": "string"
        },
        "show_label": {
          "default": true,
          "type": "boolean"
        },
        "is_markdown": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "type",
        "label"
      ],
      "title": "FormItemText",
      "type": "object"
    },
    "LegendTreeGroup": {
      "allOf": [
        {
          "$ref": "#/$defs/LegendTreeItemBase"
        },
        {
          "type": "object",
          "properties": {
            "is_mutually_exclusive": {
              "type": "boolean"
            },
            "mutually_exclusive_child_index": {
              "minimum": -1,
              "type": "integer"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LegendTreeItem"
              }
            },
            "legend_item_type": {
              "type": "string",
              "const": "group"
            }
          },
          "required": [
            "children"
          ]
        }
      ]
    },
    "LegendTreeItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/LegendTreeGroup"
        },
        {
          "$ref": "#/$defs/LegendTreeLayer"
        }
      ],
      "unevaluatedProperties": false
    },
    "LegendTreeItemBase": {
      "properties": {
        "item_id": {
          "type": "string"
        },
        "is_checked": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "legend_item_type": {
          "enum": [
            "group",
            "layer"
          ],
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "name",
        "legend_item_type"
      ],
      "title": "Child",
      "type": "object"
    },
    "LegendTreeLayer": {
      "allOf": [
        {
          "$ref": "#/$defs/LegendTreeItemBase"
        },
        {
          "type": "object",
          "properties": {
            "layer_id": {
              "type": "string"
            },
            "legend_item_type": {
              "type": "string",
              "const": "layer"
            }
          },
          "required": [
            "layer_id"
          ]
        }
      ]
    },
    "OapifDatasource": {
      "additionalProperties": false,
      "description": "A collection of an OGC API - Features service.",
      "properties": {
        "url": {
          "description": "The URL of the service landing page, e.g. `https://example.com/ogcapi`.",
          "minLength": 1,
          "type": "string"
        },
        "collection": {
          "description": "The ID of the collection, e.g. `roads`.",
          "minLength": 1,
          "type": "string"
        },
        "authcfg": {
          "description": "The ID of a QGIS authentication configuration holding the credentials, e.g. `abc1234`.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "collection"
      ],
      "title": "OGC API Features Datasource",
      "type": "object"
    },
    "OgrDatasource": {
      "additionalProperties": false,
      "description": "An existing layer in a file readable by OGR, e.g. a GeoPackage, a Shapefile or a GeoJSON file.",
      "properties": {
        "path": {
          "description": "The path to the file, e.g. `/path/to/data.gpkg`.",
          "minLength": 1,
          "type": "string"
        },
        "layer_name": {
          "description": "The name of the layer in the file, e.g. `roads`. If not set, the first layer of the file is loaded.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "OGR Datasource",
      "type": "object"
    },
    "PolymorphicRelation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "from_layer_id": {
          "type": "string"
        },
        "to_layer_field": {
          "type": "string"
        },
        "to_layer_expression": {
          "type": "string"
        },
        "to_layer_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "field_pairs": {
          "items": {
            "$ref": "#/$defs/RelationFieldPair"
          },
          "type": "array"
        },
        "strength": {
          "default": "association",
          "enum": [
            "association",
            "composition"
          ],
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "name",
        "from_layer_id",
        "to_layer_field",
        "to_layer_expression",
        "to_layer_ids"
      ],
      "title": "PolymorphicRelation",
      "type": "object"
    },
    "PostgresDatasource": {
      "additionalProperties": false,
      "description": "An existing table or view in a PostgreSQL database. The connection is set either with a `service` from the `pg_service.conf` file, or with `host`, `port` and `dbname`. Prefer `service` or `authcfg` over `username` and `password`, as these are stored as plain text in the project file.",
      "properties": {
        "table": {
          "description": "The name of the table or view, e.g. `roads`.",
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "description": "The schema of the table or view, e.g. `public`.",
          "type": "string"
        },
        "geometry_column": {
          "description": "The name of the geometry column, e.g. `geom`. Not set for tables without geometry.",
          "type": "string"
        },
        "key_column": {
          "description": "The name of the column that uniquely identifies the features, e.g. `id`. QGIS detects the primary key of tables, so it is mostly needed for views.",
          "type": "string"
        },
        "service": {
          "description": "The name of a service in the `pg_service.conf` file, e.g. `my_db`.",
          "type": "string"
        },
        "host": {
          "description": "The database server host name, e.g. `db.example.com`.",
          "type": "string"
        },
        "port": {
          "description": "The database server port, e.g. `5432`.",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "dbname": {
          "description": "The name of the database, e.g. `gis`.",
          "type": "string"
        },
        "username": {
          "description": "The database user name.",
          "type": "string"
        },
        "password": {
          "description": "The database user password, stored as plain text in the project file.",
          "type": "string"
        },
        "authcfg": {
          "description": "The ID of a QGIS authentication configuration holding the credentials, e.g. `abc1234`.",
          "type": "string"
        },
        "sslmode": {
          "description": "The SSL mode of the connection, `prefer` if not set.",
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ],
          "type": "string"
        }
      },
      "required": [
        "table"
      ],
      "title": "PostgreSQL Datasource",
      "type": "object"
    },
    "ProjectMetadata": {
      "additionalProperties": false,
      "properties": {
        "custom_properties": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "object"
        },
        "crs": {
          "default": "EPSG:4326",
          "pattern": "^EPSG:\\d+$",
          "type": "string"
        },
        "author": {
          "default": "",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "extent": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "ProjectMetadata",
      "type": "object"
    },
    "RasterDataset": {
      "additionalProperties": false,
      "properties": {
        "layer_id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "layer_type": {
          "const": "raster",
          "type": "string"
        },
        "crs": {
          "pattern": "^EPSG:\\d+$",
          "type": "string"
        },
        "custom_properties": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "object"
        },
        "is_read_only": {
          "default": false,
          "type": "boolean"
        },
        "is_identifiable": {
          "default": false,
          "type": "boolean"
        },
        "is_private": {
          "default": false,
          "type": "boolean"
        },
        "is_searchable": {
          "default": false,
          "type": "boolean"
        },
        "is_removable": {
          "default": true,
          "type": "boolean"
        },
        "datasource": {
          "type": "string"
        },
        "datasource_format": {
          "enum": [
            "wms"
          ],
          "type": "string"
        }
      },
      "required": [
        "crs",
        "datasource",
        "datasource_format",
        "name",
        "layer_type"
      ],
      "title": "RasterDataset",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "from_layer_id": {
          "type": "string"
        },
        "to_layer_id": {
          "type": "string"
        },
        "field_pairs": {
          "items": {
            "$ref": "#/$defs/RelationFieldPair"
          },
          "type": "array"
        },
        "strength": {
          "default": "association",
          "enum": [
            "association",
            "composition"
          ],
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "name",
        "from_layer_id",
        "to_layer_id"
      ],
      "title": "Relation",
      "type": "object"
    },
    "RelationFieldPair": {
      "additionalProperties": false,
      "properties": {
        "from_field": {
          "type": "string"
        },
        "to_field": {
          "type": "string"
        }
      },
      "required": [
        "from_field",
        "to_field"
      ],
      "title": "RelationFieldPair",
      "type": "object"
    },
    "VectorDataset": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "crs": {
                "pattern": "^EPSG:\\d+$"
              }
            }
          },
          "if": {
            "properties": {
              "geometry_type": {
                "const": "NoGeometry"
              }
            },
            "required": [
              "geometry_type"
            ]
          },
          "then": {
            "properties": {
              "crs": {
                "pattern": "^(EPSG:\\d+)?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "enum": [
                  "gpkg",
                  "ogr"
                ]
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "properties": {
              "datasource": {
                "$ref": "#/$defs/OgrDatasource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "const": "postgres"
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "properties": {
              "datasource": {
                "$ref": "#/$defs/PostgresDatasource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "const": "oapif"
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "properties": {
              "datasource": {
                "$ref": "#/$defs/OapifDatasource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "const": "wfs"
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "properties": {
              "datasource": {
                "$ref": "#/$defs/WfsDatasource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "const": "memory"
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "not": {
              "required": [
                "datasource"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "datasource_format": {
                "enum": [
                  "ogr",
                  "postgres",
                  "oapif",
                  "wfs"
                ]
              }
            },
            "required": [
              "datasource_format"
            ]
          },
          "then": {
            "required": [
              "datasource"
            ]
          }
        }
      ],
      "properties": {
        "layer_id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "layer_type": {
          "const": "vector",
          "type": "string"
        },
        "crs": {
          "type": "string"
        },
        "custom_properties": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "object"
        },
        "visual_styles": {
          "items": {
            "$ref": "#/$defs/VisualStyle"
          },
          "type": "array"
        },
        "is_read_only": {
          "default": false,
          "type": "boolean"
        },
        "is_identifiable": {
          "default": false,
          "type": "boolean"
        },
        "is_private": {
          "default": false,
          "type": "boolean"
        },
        "is_searchable": {
          "default": false,
          "type": "boolean"
        },
        "is_removable": {
          "default": true,
          "type": "boolean"
        },
        "geometry_type": {
          "enum": [
            "Point",
            "LineString",
            "Polygon",
            "MultiPoint",
            "MultiLineString",
            "MultiPolygon",
            "NoGeometry"
          ],
          "type": "string"
        },
        "datasource": {
          "anyOf": [
            {
              "$ref": "#/$defs/OgrDatasource"
            },
            {
              "$ref": "#/$defs/PostgresDatasource"
            },
            {
              "$ref": "#/$defs/WfsDatasource"
            },
            {
              "$ref": "#/$defs/OapifDatasource"
            }
          ],
          "description": "An existing layer to load instead of creating a new one. Its properties depend on `datasource_format`: `OgrDatasource` for `gpkg` and `ogr`, `PostgresDatasource` for `postgres`, `WfsDatasource` for `wfs` and `OapifDatasource` for `oapif`. `geometry_type` is then ignored as the data provider decides it, `crs` is still set on the layer, and `data` is not supported. Required for the `ogr`, `postgres`, `wfs` and `oapif` formats, which only load existing layers, and not supported for `memory`."
        },
        "datasource_format": {
          "enum": [
            "gpkg",
            "memory",
            "ogr",
            "postgres",
            "oapif",
            "wfs"
          ],
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "virtual_fields": {
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "form_config": {
          "allOf": [
            {
              "items": {
                "properties": {
                  "type": {
                    "enum": [
                      "tab",
                      "group_box",
                      "row"
                    ]
                  }
                }
              }
            }
          ],
          "items": {
            "$ref": "#/$defs/FormItem"
          },
          "type": "array"
        },
        "data": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "primary_key": {
          "type": "string"
        },
        "indices": {
          "items": {},
          "type": "array"
        },
        "foreign_keys": {
          "items": {},
          "type": "array"
        },
        "display_expression": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "foreign_keys",
        "indices",
        "primary_key",
        "crs",
        "datasource_format",
        "fields",
        "form_config",
        "geometry_type",
        "name",
        "layer_type"
      ],
      "title": "VectorDataset",
      "type": "object"
    },
    "VisualStyle": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "theme": {
              "type": [
                "null",
                "string"
              ]
            },
