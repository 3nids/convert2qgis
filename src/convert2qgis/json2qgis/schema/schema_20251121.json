{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DatasetGroup": {
      "additionalProperties": false,
      "properties": {
        "vector_datasets": {
          "items": {
            "$ref": "#/$defs/VectorDataset"
          },
          "type": "array"
        },
        "raster_datasets": {
          "items": {
            "$ref": "#/$defs/RasterDataset"
          },
          "type": "array"
        }
      },
      "required": [
        "vector_datasets",
        "raster_datasets"
      ],
      "title": "DatasetGroup",
      "type": "object"
    },
    "Field": {
      "additionalProperties": false,
      "dependentRequired": {
        "constraint_expression": [
          "constraint_expression_strength",
          "constraint_expression_description"
        ],
        "constraint_expression_description": [
          "constraint_expression",
          "constraint_expression_strength"
        ],
        "constraint_expression_strength": [
          "constraint_expression",
          "constraint_expression_description"
        ],
        "is_not_null": [
          "is_not_null_strength"
        ],
        "is_not_null_strength": [
          "is_not_null"
        ],
        "is_unique": [
          "is_unique_strength"
        ],
        "is_unique_strength": [
          "is_unique"
        ]
      },
      "properties": {
        "field_id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "real",
            "boolean",
            "datetime",
            "date",
            "time"
          ],
          "type": "string"
        },
        "length": {
          "minimum": 0,
          "type": "integer"
        },
        "precision": {
          "maximum": 15,
          "minimum": 0,
          "type": "integer"
        },
        "comment": {
          "type": "string"
        },
        "is_not_null": {
          "default": false,
          "type": "boolean"
        },
        "is_not_null_strength": {
          "default": "not_set",
          "enum": [
            "hard",
            "soft",
            "not_set"
          ],
          "type": "string"
        },
        "constraint_expression": {
          "default": "",
          "type": "string"
        },
        "constraint_expression_description": {
          "default": "",
          "type": "string"
        },
        "constraint_expression_strength": {
          "default": "not_set",
          "enum": [
            "hard",
            "soft",
            "not_set"
          ],
          "type": "string"
        },
        "is_unique": {
          "default": false,
          "type": "boolean"
        },
        "is_unique_strength": {
          "default": "not_set",
          "enum": [
            "hard",
            "soft",
            "not_set"
          ],
          "type": "string"
        },
        "default_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": ""
        },
        "set_default_value_on_update": {
          "type": "boolean"
        },
        "alias": {
          "type": "string"
        },
        "alias_expression": {
          "default": "",
          "type": "string"
        },
        "widget_type": {
          "enum": [
            "Hidden",
            "Color",
            "TextEdit",
            "Range",
            "DateTime",
            "ExternalResource",
            "CheckBox",
            "ValueMap",
            "ValueRelation"
          ],
          "type": "string"
        },
        "widget_config": {
          "additionalProperties": true,
          "type": "object"
        },
        "is_read_only": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "alias",
        "comment",
        "length",
        "name",
        "precision",
        "set_default_value_on_update",
        "type",
        "widget_config",
        "widget_type"
      ],
      "title": "Field",
      "type": "object"
    },
    "FormItem": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "item_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "tab",
                "group_box",
                "row"
              ],
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "children": {
              "items": {
                "$ref": "#/$defs/FormItem"
              },
              "type": "array"
            },
            "visibility_expression": {
              "default": "",
              "type": "string"
            },
            "background_color": {
              "default": "",
              "type": "string"
            },
            "is_collapsed": {
              "default": false,
              "type": "boolean"
            },
            "column_count": {
              "default": 1,
              "type": "integer"
            }
          },
          "required": [
            "item_id",
            "type",
            "label"
          ],
          "title": "FormItemContainer",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "item_id": {
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "enum": [
                "field",
                "relation"
              ],
              "type": "string"
            },
            "field_name": {
              "minLength": 1,
              "type": "string"
            },
            "visibility_expression": {
              "default": "",
              "type": "string"
            },
            "show_label": {
              "default": true,
              "type": "boolean"
            },
            "is_read_only": {
              "default": false,
              "type": "boolean"
            },
            "is_label_on_top": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "item_id",
            "type",
            "field_name"
          ],
          "title": "FormItemField",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "item_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "text"
              ],
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "visibility_expression": {
              "default": "",
              "type": "string"
            },
            "show_label": {
              "default": true,
              "type": "boolean"
            },
            "is_markdown": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "item_id",
            "type",
            "label"
          ],
          "title": "FormItemText",
          "type": "object"
        }
      ]
    },
    "LegendTreeGroup": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "type": "string"
        },
        "legend_item_type": {
          "const": "group",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "is_checked": {
          "default": true,
          "type": "boolean"
        },
        "is_mutually_exclusive": {
          "default": false,
          "type": "boolean"
        },
        "mutually_exclusive_child_index": {
          "default": -1,
          "minimum": -1,
          "type": "integer"
        },
        "children": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/LegendTreeGroup"
              },
              {
                "$ref": "#/$defs/LegendTreeLayer"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "name",
        "legend_item_type",
        "children"
      ],
      "title": "LegendTreeGroup",
      "type": "object"
    },
    "LegendTreeLayer": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "type": "string"
        },
        "legend_item_type": {
          "const": "layer",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "is_checked": {
          "default": true,
          "type": "boolean"
        },
        "layer_id": {
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "name",
        "legend_item_type",
        "layer_id"
      ],
      "title": "LegendTreeLayer",
      "type": "object"
    },
    "PolymorphicRelation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "from_layer_id": {
          "type": "string"
        },
        "to_layer_field": {
          "type": "string"
        },
        "to_layer_expression": {
          "type": "string"
        },
        "to_layer_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "field_pairs": {
          "items": {
            "$ref": "#/$defs/RelationFieldPair"
          },
          "type": "array"
        },
        "strength": {
          "default": "association",
          "enum": [
            "association",
            "composition"
          ],
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "name",
        "from_layer_id",
        "to_layer_field",
        "to_layer_expression",
        "to_layer_ids"
      ],
      "title": "PolymorphicRelation",
      "type": "object"
    },
    "ProjectMetadata": {
      "additionalProperties": false,
      "properties": {
        "custom_properties": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "object"
        },
        "crs": {
          "default": "EPSG:4326",
          "pattern": "^EPSG:\\d+$",
          "type": "string"
        },
        "author": {
          "default": "",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "extent": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "ProjectMetadata",
      "type": "object"
    },
    "RasterDataset": {
      "additionalProperties": false,
      "properties": {
        "layer_id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "layer_type": {
          "const": "raster",
          "type": "string"
        },
        "crs": {
          "pattern": "^EPSG:\\d+$",
          "type": "string"
        },
        "custom_properties": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "object"
        },
        "visual_styles": {
          "items": {
            "$ref": "#/$defs/VisualStyle"
          },
          "type": "array"
        },
        "is_read_only": {
          "default": false,
          "type": "boolean"
        },
        "is_identifiable": {
          "default": false,
          "type": "boolean"
        },
        "is_private": {
          "default": false,
          "type": "boolean"
        },
        "is_searchable": {
          "default": false,
          "type": "boolean"
        },
        "is_removable": {
          "default": true,
          "type": "boolean"
        },
        "datasource": {
          "type": "string"
        },
        "datasource_format": {
          "enum": [
            "wms"
          ],
          "type": "string"
        }
      },
      "required": [
        "crs",
        "datasource",
        "datasource_format",
        "name",
        "layer_type"
      ],
      "title": "RasterDataset",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "from_layer_id": {
          "type": "string"
        },
        "to_layer_id": {
          "type": "string"
        },
        "field_pairs": {
          "items": {
            "$ref": "#/$defs/RelationFieldPair"
          },
          "type": "array"
        },
        "strength": {
          "default": "association",
          "enum": [
            "association",
            "composition"
          ],
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "name",
        "from_layer_id",
        "to_layer_id"
      ],
      "title": "Relation",
      "type": "object"
    },
    "RelationFieldPair": {
      "additionalProperties": false,
      "properties": {
        "from_field": {
          "type": "string"
        },
        "to_field": {
          "type": "string"
        }
      },
      "required": [
        "from_field",
        "to_field"
      ],
      "title": "RelationFieldPair",
      "type": "object"
    },
    "VectorDataset": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "crs": {
                "pattern": "^EPSG:\\d+$"
              }
            }
          },
          "if": {
            "properties": {
              "geometry_type": {
                "const": "NoGeometry"
              }
            },
            "required": [
              "geometry_type"
            ]
          },
          "then": {
            "properties": {
              "crs": {
                "pattern": "^(EPSG:\\d+)?$"
              }
            }
          }
        }
      ],
      "properties": {
        "layer_id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "layer_type": {
          "const": "vector",
          "type": "string"
        },
        "crs": {
          "type": "string"
        },
        "custom_properties": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "object"
        },
        "visual_styles": {
          "items": {
            "$ref": "#/$defs/VisualStyle"
          },
          "type": "array"
        },
        "is_read_only": {
          "default": false,
          "type": "boolean"
        },
        "is_identifiable": {
          "default": false,
          "type": "boolean"
        },
        "is_private": {
          "default": false,
          "type": "boolean"
        },
        "is_searchable": {
          "default": false,
          "type": "boolean"
        },
        "is_removable": {
          "default": true,
          "type": "boolean"
        },
        "geometry_type": {
          "enum": [
            "Point",
            "LineString",
            "Polygon",
            "MultiPoint",
            "MultiLineString",
            "MultiPolygon",
            "NoGeometry"
          ],
          "type": "string"
        },
        "datasource_format": {
          "enum": [
            "gpkg",
            "memory"
          ],
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "virtual_fields": {
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "form_config": {
          "items": {
            "$ref": "#/$defs/FormItem"
          },
          "type": "array"
        },
        "data": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "primary_key": {
          "type": "string"
        },
        "indices": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "foreign_keys": {
          "items": {},
          "type": "array"
        },
        "display_expression": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "foreign_keys",
        "indices",
        "primary_key",
        "crs",
        "datasource_format",
        "fields",
        "form_config",
        "geometry_type",
        "name",
        "layer_type"
      ],
      "title": "VectorDataset",
      "type": "object"
    },
    "VisualStyle": {
      "additionalProperties": false,
      "properties": {
        "theme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Currently ignored when building the project."
        },
        "qml_filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A path to a QGIS Layer Style file (.qml) that defines the visual style for the layer. The path can be absolute or relative to the JSON file."
        },
        "qml_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The content of a QGIS Layer Style file (.qml) that defines the visual style for the layer."
        }
      },
      "title": "VisualStyle",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project": {
      "$ref": "#/$defs/ProjectMetadata"
    },
    "version": {
      "type": "string"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/DatasetGroup"
      },
      "type": "array"
    },
    "legend_tree": {
      "$ref": "#/$defs/LegendTreeGroup"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "type": "array"
    },
    "polymorphic_relations": {
      "items": {
        "$ref": "#/$defs/PolymorphicRelation"
      },
      "type": "array"
    }
  },
  "required": [
    "datasets",
    "project",
    "relations",
    "polymorphic_relations",
    "legend_tree",
    "version"
  ],
  "title": "Project",
  "type": "object"
}
